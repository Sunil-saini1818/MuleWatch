# ---- MuleWatch command center (runs on your laptop) ----
# Public forum to monitor (your server)
FORUM_URL=http://103.155.85.18:8100
# Must match FORUM_MOD_TOKEN on the forum server (used for "Request takedown")
FORUM_MOD_TOKEN=skit-cybercell-2026
# Crawl interval in seconds
CRAWL_INTERVAL=3

# Optional: Telegram bot (create one with @BotFather).
#  - Critical alerts to your phone: send /alerts <code> to the bot (code shown on Monitored sources),
#    or set TELEGRAM_CHAT_ID here
#  - the same bot also becomes the citizen reporting bot (people forward suspicious ads to it)
#  - set REPORT_BOT_TOKEN only if you want a separate bot for citizen reports
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPORT_BOT_TOKEN=
REPORTS_PER_HOUR=30
ALERT_MIN_LEVEL=Critical
PUBLIC_BASE_URL=http://localhost:8000

# Optional: Claude "AI analyst" second opinion for manual submissions
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
