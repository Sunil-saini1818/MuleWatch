{
  "manifest_version": 3,
  "name": "MuleWatch Field Check",
  "version": "1.0.0",
  "description": "Right-click any post, text or image to check it for bank-account / ATM-card selling with the MuleWatch command center.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "48": "icon48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "storage", "notifications", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*", "<all_urls>"]
}
